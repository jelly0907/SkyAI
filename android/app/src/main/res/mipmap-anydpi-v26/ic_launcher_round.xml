<?xml version="1.0" encoding="utf-8"?>
<!--
  Round-icon variant. Same content as ic_launcher.xml — the launcher
  applies a circular mask itself, so we don't need a different shape here.
  We just need this resource to exist so the manifest's android:roundIcon
  attribute resolves and AAPT linking succeeds.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
