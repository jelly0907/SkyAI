<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). The launcher composites foreground and
  background and applies the device-specific mask (circle, squircle, etc.).
  minSdk is 26 in app/build.gradle.kts so we don't need pre-26 PNG fallbacks.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
