# SkyAI backend environment — TEMPLATE.
#
# Copy this file to `backend/.env` (which is gitignored) and fill in your
# own values. Never commit a real `.env` — it contains API keys.
#
#   cp backend/.env.example backend/.env

# ── Flight provider ──────────────────────────────────────────────────────────
# Which upstream supplies flight data. Options:
#   mock     — hard-coded demo offers (no network, no API key needed)
#   duffel   — Duffel sandbox / production
#   amadeus  — Amadeus self-service test or production
FLIGHT_PROVIDER=mock

# ── Duffel ───────────────────────────────────────────────────────────────────
# Sign up at https://app.duffel.com → Settings → Access tokens → Create token.
# Test-mode tokens start with `duffel_test_`. Required when FLIGHT_PROVIDER=duffel.
DUFFEL_API_KEY=

# ── Amadeus ──────────────────────────────────────────────────────────────────
# Required only when FLIGHT_PROVIDER=amadeus.
# Get credentials at https://developers.amadeus.com → My Self-Service Workspace.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# `test` hits the sandbox; `production` hits the paid live API.
AMADEUS_ENV=test

# ── Misc ─────────────────────────────────────────────────────────────────────
# Force the mock generator on regardless of FLIGHT_PROVIDER. Handy for offline
# dev. Leave `false` once you have real provider credentials configured.
USE_MOCK_DATA=false

# CORS allow-list. Comma-separated origins, or `*` for any origin during dev.
ALLOWED_ORIGINS=*

# SQLAlchemy database URL.
#   Dev (default):  sqlite+aiosqlite:///./skyai.db
#   Production:     postgresql+asyncpg://user:pw@host:5432/skyai
DATABASE_URL=sqlite+aiosqlite:///./skyai.db
